{
  "schemaVersion": 1,
  "name": "Reading list",
  "source": {
    "entry": "src/App.jsx",
    "paths": [
      "src/App.jsx",
      "src/api.js",
      "src/main.jsx",
      "src/app.css",
      "index.html",
      "vite.config.js",
      "package.json",
      "package-lock.json",
      "api/server.js",
      "api/books.json",
      "observed-server.mjs"
    ]
  },
  "setup": [
    ["npm", "install"],
    ["npm", "run", "build"]
  ],
  "start": ["node", "observed-server.mjs"],
  "ready": { "path": "/", "status": 200 },
  "capture": {
    "name": "Open Reading shelf",
    "path": "/",
    "ready": [
      { "kind": "wait-text", "text": "Pick a shelf" },
      { "kind": "network-idle" }
    ],
    "steps": [
      { "kind": "click-role", "role": "button", "name": "Reading" },
      { "kind": "wait-text", "text": "2 books" },
      { "kind": "wait-text", "text": "The Left Hand of Darkness" },
      { "kind": "network-idle" }
    ],
    "check": {
      "kind": "browser-errors",
      "id": "no-browser-errors",
      "name": "No browser errors",
      "scope": "One Reading click through completion and network idle."
    },
    "allowedOrigins": ["http://127.0.0.1:4010"],
    "browserArguments": ["--no-sandbox"]
  }
}
