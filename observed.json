{
  "schemaVersion": 1,
  "name": "Reading list",
  "source": {
    "entry": "src/App.jsx",
    "paths": [
      "src/App.jsx",
      "src/api.js",
      "src/main.jsx",
      "src/app.css",
      "index.html",
      "vite.config.js",
      "package.json",
      "package-lock.json",
      "api/server.js",
      "api/books.json",
      "observed-server.mjs"
    ]
  },
  "setup": [
    ["npm", "install"],
    ["sh", "-c", "VITE_API_URL=http://127.0.0.1:4015 npm run build"]
  ],
  "start": ["sh", "-c", "API_PORT=4015 exec node observed-server.mjs"],
  "ready": { "path": "/", "status": 200 },
  "capture": {
    "name": "Open Reading shelf",
    "path": "/",
    "ready": [
      { "kind": "wait-text", "text": "Pick a shelf" },
      { "kind": "network-idle" }
    ],
    "steps": [
      { "kind": "click-role", "role": "button", "name": "Reading" },
      { "kind": "wait-text", "text": "2 books" },
      { "kind": "wait-text", "text": "The Left Hand of Darkness" },
      { "kind": "network-idle" }
    ],
    "checks": [
      {
        "kind": "request-count",
        "id": "one-books-request",
        "name": "One books request per shelf click",
        "scope": "One Reading click through completion and network idle.",
        "method": "GET",
        "origin": "http://127.0.0.1:4015",
        "path": "/api/books",
        "expectedCount": 1,
        "status": 200
      },
      {
        "kind": "react-renders",
        "id": "book-list-renders",
        "name": "BookList renders at most twice",
        "scope": "One Reading click through the loaded list, in a separate React DevTools run.",
        "component": "BookList",
        "maxRenders": 2
      }
    ],
    "allowedOrigins": ["http://127.0.0.1:4015"],
    "browserArguments": ["--no-sandbox"]
  }
}
