{
  "schemaVersion": 1,
  "name": "Reading list",
  "source": {
    "entry": "src/App.jsx",
    "paths": [
      "src",
      "api",
      "index.html",
      "vite.config.js",
      "package.json",
      "package-lock.json"
    ]
  },
  "setup": [
    ["npm", "ci"],
    ["npm", "run", "build"]
  ],
  "start": [
    "sh",
    "-c",
    "node api/server.js & exec node_modules/.bin/vite preview --host 127.0.0.1 --port \"$PORT\" --strictPort"
  ],
  "ready": { "path": "/", "status": 200 },
  "capture": {
    "name": "Open Reading shelf",
    "path": "/",
    "ready": [
      { "kind": "wait-text", "text": "Pick a shelf" },
      { "kind": "network-idle" }
    ],
    "steps": [
      { "kind": "click-role", "role": "button", "name": "Reading" },
      { "kind": "wait-selector", "selector": "main ul li" },
      { "kind": "network-idle" }
    ],
    "checks": [
      {
        "kind": "request-count",
        "id": "one-books-request",
        "name": "One books request per shelf click",
        "scope": "One Reading click through the book list and network idle",
        "method": "GET",
        "origin": "http://127.0.0.1:4010",
        "path": "/api/books",
        "expectedCount": 1,
        "status": 200
      },
      {
        "kind": "text",
        "id": "reading-shelf-count",
        "name": "Reading shelf shows its book count",
        "scope": "Status line after opening the Reading shelf",
        "selector": "p[role=\"status\"]",
        "expectedText": "2 books"
      }
    ],
    "allowedOrigins": ["http://127.0.0.1:4010"],
    "browserArguments": ["--no-sandbox"]
  }
}
