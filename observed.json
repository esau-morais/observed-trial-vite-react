{
  "schemaVersion": 1,
  "name": "Reading list",
  "source": {
    "entry": "src/App.jsx",
    "paths": [
      "src/App.jsx",
      "src/api.js",
      "src/main.jsx",
      "src/app.css",
      "index.html",
      "vite.config.js",
      "package.json",
      "package-lock.json",
      "api/server.js",
      "api/books.json",
      "observed-server.mjs",
      "playwright.config.js",
      "e2e/shelves.spec.js"
    ]
  },
  "setup": [
    ["npm", "install"],
    ["npm", "run", "build"]
  ],
  "start": ["node", "observed-server.mjs"],
  "ready": { "path": "/", "status": 200 },
  "capture": {
    "name": "Open Reading shelf",
    "path": "/",
    "ready": [
      { "kind": "wait-text", "text": "Pick a shelf" },
      { "kind": "network-idle" }
    ],
    "steps": [
      { "kind": "click-role", "role": "button", "name": "Reading" },
      { "kind": "wait-text", "text": "2 books" },
      { "kind": "wait-text", "text": "The Left Hand of Darkness" },
      { "kind": "network-idle" }
    ],
    "check": {
      "kind": "request-count",
      "id": "one-books-request",
      "name": "One books request per shelf click",
      "scope": "One Reading click through completion and network idle.",
      "method": "GET",
      "origin": "http://127.0.0.1:4010",
      "path": "/api/books",
      "expectedCount": 1,
      "status": 200
    },
    "allowedOrigins": ["http://127.0.0.1:4010"],
    "browserArguments": ["--no-sandbox"],
    "collectors": [
      {
        "kind": "playwright",
        "command": ["npx", "playwright", "test", "--reporter=line,json"]
      }
    ]
  }
}
